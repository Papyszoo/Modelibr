# Test results and artifacts. Globbed: the mega-runner gives each e2e suite its
# own pair (test-results-fast/, playwright-report-full/, ...) so a full run does
# not leave the suites overwriting each other's reports.
test-results*/
playwright-report*/
blob-report/
blob-all/
.features-gen/

# E2E environment data
data/

# Node modules
node_modules/

# Temporary files
*.log
webapi_e2e_logs.txt

# Shared state files (used for test data persistence)
.shared-state.json
.setup-state.json
fixtures/.shared-state.json
