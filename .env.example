# Web API
ASPNETCORE_ENVIRONMENT=Development
HTTPS_PORT=8443
EXPOSE_443_PORT=true

# Storage Configuration
UPLOAD_STORAGE_PATH=/var/lib/modelibr/uploads

FRONTEND_PORT=3010
VITE_API_BASE_URL=/api
# Development/test override for the in-app Asset Store origin. Normal builds
# use the hosted Modelibr Store; change this only when testing against a local
# Store instance or the page's unconfigured state.
VITE_STORE_URL=https://store.modelibr.com
# HTTPS WebDAV port - also used as alias to the frontend over HTTPS.
# Use 443 for best Windows WebDAV compatibility (no registry edits needed).
# Remove this line to disable HTTPS WebDAV exposure.
WEBDAV_HTTPS_PORT=443
# HTTP WebDAV port - preferred for local networks (no TLS required).
# Windows \\server\modelibr resolves via HTTP on port 80 by default.
# Remove this line to disable HTTP WebDAV exposure.
WEBDAV_HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=modelibr
POSTGRES_PASSWORD=ChangeThisStrongPassword123!
POSTGRES_PORT=5432
# Backups need no client tools (pg_dump/pg_restore/psql): the app writes and reads
# its dumps through the PostgreSQL driver it already uses, so a packaged install
# works with a server-only PostgreSQL. Those variables are gone rather than
# deprecated - see docs/docs/features/backups.md.

# Pre-migration backup safety net - at startup, if pending EF Core migrations are
# detected, the app takes an automatic DB-scope backup (prefix "pre-migration-")
# before applying them, and aborts startup if that backup fails. See
# docs/docs/features/backups.md.
# The Settings page (Backup & Restore) can also switch this off; when this
# variable is explicitly set, it wins over the stored setting.
# Set to true to bypass the backup and apply migrations unconditionally (NOT
# recommended outside throwaway/CI databases - there is no rollback point).
MODELIBR_SKIP_PREMIGRATION_BACKUP=false
# How many pre-migration-*.tar snapshots to keep before older ones are pruned.
# User-initiated backups (the "modelibr-*" prefix) are never touched by this.
# The Settings page (Backup & Restore) can also set this; when this variable is
# explicitly set, it wins over the stored setting.
MODELIBR_PREMIGRATION_BACKUP_RETENTION=3

# Asset Processor Service
WORKER_PORT=3001
WORKER_ID=worker-1
WORKER_API_KEY=change-me-to-a-secure-random-key
MAX_CONCURRENT_JOBS=3
# How many render jobs one worker runs at once. All renders share a single
# Chromium per worker; each job's page is closed when it finishes. Default 1
# keeps one live WebGL context per worker during a large re-queue.
MAX_CONCURRENT_RENDER_JOBS=1
# Close the shared Chromium after this many ms with no render job; an idle
# browser holds ~3.7 GB. The next job relaunches it lazily. 0 disables.
BROWSER_IDLE_TIMEOUT_MS=60000
# Poll interval (ms) for the decoupled extraction queue (re-derive / on-demand)
EXTRACTION_POLL_INTERVAL_MS=5000
# How many extraction jobs run at once, and how many one poll may claim. Its own
# budget: MAX_CONCURRENT_JOBS governs thumbnail rendering only, and extraction had
# no knob at all - one job at a time behind a 10-per-tick cap. Each concurrent job
# holds a renderer, so raising this raises memory use too.
EXTRACTION_CONCURRENCY=3
EXTRACTION_BATCH_SIZE=30
# Poll interval (ms) for Blender operations (UV unwrap, bake). Slower on purpose:
# these jobs are minutes long and rare, so a tighter loop only adds requests.
BLENDER_POLL_INTERVAL_MS=10000
# How long one Blender run may take before the worker kills it. Kept under the
# queue's lease for the operation so an overrunning run is reported as a failure
# by the worker that owns it rather than re-claimed by another.
# The Settings page (Blender → Operation timeout) is the primary source; this
# env value is the worker's fallback when no timeout is stored.
BLENDER_OPERATION_TIMEOUT_MS=900000
RENDER_WIDTH=256
RENDER_HEIGHT=256
RENDER_FORMAT=png
# Scene render-back photographs the running app rather than assembling the scene
# a second time, so the worker needs the frontend's address. This is resolved
# from INSIDE the worker container - the default is the compose service, not a
# localhost port. Override only if the frontend is served from somewhere else.
WORKER_FRONTEND_URL=http://frontend:80
SCENE_RENDER_WIDTH=768
SCENE_RENDER_HEIGHT=768
SCENE_RENDER_TIMEOUT_MS=60000
LOG_LEVEL=info
# Metadata extraction (deterministic pixel stats + bounded script parsing)
MATERIAL_SAMPLE_SIZE=256
SCRIPT_MAX_BYTES=2097152
SCRIPT_TIMEOUT_MS=5000

# Thumbnail Storage
THUMBNAIL_STORAGE_ENABLED=true
THUMBNAIL_STORAGE_PATH=/var/lib/modelibr/thumbnails
# Fallback only: the Settings page (Thumbnail Generation → Reuse duplicate
# thumbnails) is the primary source for reusing a rendered thumbnail when the
# same model file is uploaded again.
SKIP_DUPLICATE_THUMBNAILS=true

# Companion Asset Store the BACKEND reads (optional). VITE_STORE_URL above is the
# browser's store; this is the one the MCP store tools search server-side, so an agent
# can find an asset the library does not have. Unset = the store tools report
# "not configured" and nothing else changes. https only (http for localhost).
# STORE_URL=https://store.modelibr.com
# STORE_CATALOG_HTTP_TIMEOUT_SECONDS=10

# Store importer (optional - pulling asset packs from the companion Asset Store).
# All optional; sensible defaults apply when unset.
# STORE_IMPORT_HTTP_TIMEOUT_SECONDS=120
# STORE_IMPORT_MAX_FILE_BYTES=2147483648
# STORE_IMPORT_MAX_MANIFEST_BYTES=16777216
# STORE_IMPORT_MAX_REDIRECTS=5

# Local MCP agent server (see docs/docs/features/mcp-server.md)
# Read tools are served at /mcp by default; set to false to remove the endpoint.
# The Settings page (MCP explorer) can also change the three toggles below; when
# one of these variables is explicitly set, it wins over the stored setting, and
# a change applies after restarting the Web API.
MCP_ENABLED=true
# Write tools (tag/categorize/pack/import/re-derive) are OFF by default: the MCP
# endpoint shares the Web API's network exposure, so letting an agent mutate the
# library is a deliberate opt-in. Every write is idempotency-keyed and audited.
MCP_WRITE_ENABLED=false
# Deleting (recycling) assets and undoing writes that deleting undoes are gated
# separately from ordinary writes: those tools destroy work rather than adding it.
# Dry runs still report what would happen while this is off.
MCP_DESTRUCTIVE_ENABLED=false
# Per-token scoping for the agent surface. Unset = unauthenticated, which is the
# right default for a loopback-only instance and matches the rest of Modelibr.
# Configure it BEFORE letting anything beyond this machine reach /mcp: without it,
# any client that can reach the endpoint gets every tool the endpoint exposes.
# Format: name:scopes:secret, entries separated by ';'. Scopes: read, write,
# destructive (write implies read). The name is recorded as the actor on every
# write the token makes. A malformed value fails startup rather than silently
# leaving the endpoint open.
# MCP_TOKENS=curator:read,write:GENERATE_A_LONG_RANDOM_SECRET

# Blender (optional - installed at runtime via the Settings UI)
# The WebApi downloads the selected version into shared Docker storage.
# Override the install path with BLENDER_INSTALL_PATH if needed.
# BLENDER_INSTALL_PATH=/var/lib/modelibr/blender

# Docker (optional)
DOCKER_REGISTRY=
HOST_UID=1000
HOST_GID=1000
